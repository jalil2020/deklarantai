# Claude API kaliti (chat va AI izohlari uchun majburiy).
# Kalitni https://console.anthropic.com dan oling.
ANTHROPIC_API_KEY=

# Ixtiyoriy: model (default: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Ixtiyoriy: server porti (default: 8080)
PORT=8080

# Ixtiyoriy: TIF TN bazasi yo'li (default: data/hscodes.json)
HSCODE_DATA=data/hscodes.json
