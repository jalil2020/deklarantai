# Deklarant AI — muhit o'zgaruvchilari
#
# ⚠️ BU FAYL AVTOMATIK O'QILMAYDI. Server `os.Getenv` ishlatadi va hech
# qanday .env yuklovchi kutubxona yo'q (loyihada tashqi bog'liqlik yo'q).
# Fayl — QO'LLANMA, konfiguratsiya emas. Qiymatlarni haqiqiy muhitga
# bering:
#
#   PowerShell:  $env:ANTHROPIC_API_KEY = "sk-ant-..."; go run .
#   bash:        ANTHROPIC_API_KEY=sk-ant-... go run .
#   systemd:     [Service] EnvironmentFile=/etc/deklarant.env
#
# Amaldagi qiymatlarni ko'rish: /admin → «Sozlamalar» (maxfiylari
# ko'rsatilmaydi — faqat sozlangan/sozlanmagan holati).
#
# Bu ro'yxat `internal/api/settings.go` dagi registrga mos bo'lishi shart
# — `TestEnvExampleCoversRegistry` buni tekshiradi.

# ─── AI — Claude ──────────────────────────────────────────────────────
# Claude kaliti. Bo'lmasa chat butunlay o'chiq.
ANTHROPIC_API_KEY=
# Asosiy model: rasm va hisob-kitob.
ANTHROPIC_MODEL=claude-opus-4-8
# ⚠️ SUKUT BO'YICHA O'CHIQ (bo'sh = hamma narsa asosiy modelda).
# Yoqilsa, faqat sof ma'lumot o'qish savollari shu modelga ketadi.
# Bir marta keng yoqilganda javob sifati sezilarli pasaygan edi.
# Yoqish uchun: claude-sonnet-5
ANTHROPIC_MID_MODEL=
# ⚠️ SUKUT BO'YICHA O'CHIQ (bo'sh = bo'sh gap ham asosiy modelda).
# Yoqish uchun: claude-haiku-4-5-20251001
ANTHROPIC_FAST_MODEL=
# Korporativ shlyuz yoki testdagi soxta server.
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# Javob uzunligi chegarasi (ikkala provayder uchun).
ANTHROPIC_MAX_TOKENS=2048
# Kesh muddati. Bo'sh = 5 daqiqa. "1h" — siyrak trafikda arzonroq.
# ⚠️ O'lchangan: so'rovlar 9 daqiqa oralab kelganda kesh HAR SAFAR qayta
# yozildi va bir marta ham o'qilmadi — ya'ni faqat 1,25x qimmatlashtirdi.
ANTHROPIC_CACHE_TTL=

# ─── AI — GLM (Z.ai) ──────────────────────────────────────────────────
# ⚠️ O'CHIQ. "1" qilinsagina GLM ishlatiladi; aks holda HAMMA so'rov Claude da.
GLM_ENABLED=
# Arzon provayder kaliti (GLM_ENABLED=1 bilan birga).
GLM_API_KEY=
# Z.ai modeli. ⚠️ GLM-5.2 rasmni qo'llab-quvvatlamaydi.
GLM_MODEL=glm-5.2
# OpenAI-mos endpoint.
GLM_API_URL=https://api.z.ai/api/paas/v4/chat/completions
# 1M kontekstda birinchi belgi kechikishi uzun bo'lishi mumkin.
GLM_TIMEOUT_SECONDS=180

# ─── Cheklovlar ───────────────────────────────────────────────────────
# Bitta IP dan daqiqasiga chat so'rovi (0 = o'chiq).
RATE_PER_MIN=10
# Bitta IP dan kuniga chat so'rovi (0 = o'chiq).
DAILY_QUOTA=100
# So'rov hajmi chegarasi (rasm base64 bilan keladi).
MAX_BODY_BYTES=8388608
# 1 bo'lsa X-Forwarded-For ga ishoniladi. ⚠️ Faqat ishonchli proksi orqasida.
TRUST_PROXY=

# ─── Mijoz ────────────────────────────────────────────────────────────
# "nom:sir" ro'yxati (vergul bilan). Mobil ilova va hamkorlar uchun.
API_KEYS=
# Anonim token imzosi. Berilmasa har ishga tushishda tasodifiy — ya'ni
# tokenlar kuchini yo'qotadi. Bir nechta nusxada BIR XIL bo'lishi shart.
CLIENT_TOKEN_SECRET=
# Anonim token muddati (masalan 24h, 12h).
CLIENT_TOKEN_TTL=24h
# CORS uchun ruxsat etilgan manbalar. Bo'sh bo'lsa — hammasi (*).
ALLOWED_ORIGINS=
# Foydalanuvchilar ombori. Parol xeshlari bor — git ga tushmasin.
USERS_DATA=data/users.json

# ─── Server ───────────────────────────────────────────────────────────
# Server porti.
PORT=8080
# Admin paneli paroli. Bo'lmasa /admin yo'llari umuman mavjud emas.
ADMIN_PASSWORD=

# ─── Ma'lumot ─────────────────────────────────────────────────────────
# TIF TN kodlar bazasi.
HSCODE_DATA=data/hscodes.json
# Qonun korpusi.
LAWS_DATA=data/laws.json
# Hujjat talablari.
DOCS_DATA=data/docs.json
# Davlatlar ma'lumotnomasi (kelib chiqish).
COUNTRIES_DATA=data/countries.json
# Bo'lim/guruh sarlavhalari (sidebar brauzeri). Ixtiyoriy.
TAXONOMY_DATA=data/taxonomy.json

# ─── Tashqi xizmatlar ─────────────────────────────────────────────────
# Markaziy bank valyuta kurslari.
CBU_API_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json
# Tadbirkor rejimida beriladigan murojaat kanali.
CONTACT_TELEGRAM=https://t.me/declarant_pro
